# Copy this file to keys.env and fill in your keys.
# keys.env stays on the server: the browser never receives it, and .gitignore keeps it out of GitHub.

# Google AI Studio -> Get API key
GEMINI_API_KEY=
# reads/sorts what the owner typed
GEMINI_MODEL_LITE=gemini-3.5-flash-lite
# thinks, calculates and summarises (check the exact id with "ตรวจสอบโมเดล" in Settings)
GEMINI_MODEL_THINK=gemini-3.8-flash

# ElevenLabs -> Developers -> API Keys (Text to Speech: Access, Voices: Read, Models: Access)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_v3
# optional default voice id (pick one in Settings if empty)
ELEVENLABS_VOICE_ID=

# optional: ask for this password before anyone can use the AI through this server
ACCESS_PASSWORD=

# 127.0.0.1 = only this computer can open the site. Use 0.0.0.0 to allow other devices on the network (set ACCESS_PASSWORD then).
HOST=127.0.0.1
PORT=8765
